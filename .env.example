# Set to true only for local development without a PostgreSQL server.
# For a real deployment, use a PostgreSQL database and leave this unset or false.
USE_IN_MEMORY_DB=false

# PostgreSQL connection string format:
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_activity
JWT_SECRET=supersecretkey
PORT=5000
VITE_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# SMTP settings for password reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@domain.com
SMTP_PASS=your-email-password
SMTP_FROM="Accessfull <no-reply@yourdomain.com>"
